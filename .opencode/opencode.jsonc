{
    "$schema": "https://opencode.ai/config.json",
    "model": "openrouter/~z-ai/glm-flash-latest#max",
    "small_model": "openrouter/~z-ai/glm-flash-latest#low",
    "logLevel": "WARN",
    "enabled_providers": [
        "openrouter"
    ],
    "providers": {
        "openrouter": {
            "body": {
                "provider": {
                    "allow_fallbacks": true,
                    "zdr": true,
                    "data_collection": "deny",
                    "sort": {
                        "by": "price"
                    },
                    "preferred_min_throughput": {
                        "p90": 40
                    }
                }
            }
        }
    }
}